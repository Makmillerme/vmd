# IMAP (UKR.NET)
IMAP_HOST=imap.ukr.net
IMAP_PORT=993
IMAP_USER=your_mail@ukr.net
IMAP_PASS=your_imap_app_password

# SMTP (weekly report)
SMTP_HOST=smtp.ukr.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=VMD Extractor
EMAIL=dept1@example.com,dept2@example.com

# File filters
MIN_SIZE_KB=280
MAX_SIZE_KB=320
DOWNLOAD_DELAY=2.0
LOCAL_TIMEZONE=Europe/Kyiv

# SQLite (inside volume vmd_extractor/data/db/)
VMD_DB_FILENAME=vmd_data.sqlite3

# Trello
TRELLO_ENABLED=true
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_ID=
TRELLO_LABEL_CARD_ID=

# Optional Trello label overrides (see README)
# TRELLO_LABEL_CONTAINER_ID=
# TRELLO_LABEL_TRUCK_ID=

# Brief / Google Drive (optional)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_WEB_APP_URL=
GOOGLE_DRIVE_API_KEY=

# Logging
VMD_LOG_FILENAME=vmd_downloader.log
